#!/bin/bash
# fnOS 生命周期脚本的 PATH 受限, 必须显式设置
export PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_SERVER="${TRIM_APPDEST}/auto-powerd"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

start_process() {
    if status; then
        return 0
    fi
    log_msg "Starting process ..."
    if [ ! -f "${APP_SERVER}" ]; then
        log_msg "ERROR: Application server not found: ${APP_SERVER}"
        return 1
    fi
    mkdir -p "${TRIM_PKGVAR}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"
    export TRIM_PKGETC="${TRIM_PKGETC}"
    export TRIM_APPDEST="${TRIM_APPDEST}"
    # 使用绝对路径启动 Python (fnOS 环境 PATH 可能不含 python3)
    nohup /usr/bin/python3 "${APP_SERVER}" >> "${LOG_FILE}" 2>&1 &
    write_pid=$!
    printf "%s" "$write_pid" > ${PID_FILE}
    log_msg "CMD = python3 ${APP_SERVER}"
    log_msg "pid = $write_pid"
    sleep 3
    if ! check_process "${write_pid}"; then
        log_msg "FAILED to start service"
        rm -f ${PID_FILE}
        return 1
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi
        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done
        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed..."
        fi
    fi
    pkill -f "auto-powerd" 2>/dev/null || true
    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    if command -v ss >/dev/null 2>&1 && ss -ltnp 2>/dev/null | grep -q ":8465 "; then
        return 0
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
